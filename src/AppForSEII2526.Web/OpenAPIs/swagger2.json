  "components": {
    "schemas": {
      "BookingDetailDTO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "surname": {
            "type": "string",
            "nullable": true
          },
          "deliveryAddress": {
            "type": "string",
            "nullable": true
          },
          "paymentMethod": {
            "$ref": "#/components/schemas/PaymentMethod"
          },
          "clientPhoneNumber": {
            "type": "string",
            "nullable": true
          },
          "bookingDate": {
            "type": "string",
            "format": "date-time"
          },
          "bookingItems": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BookingItemDTO"
            },
            "nullable": true
          },
          "numberOfDays": {
            "type": "integer",
            "format": "int32"
          },
          "price": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "BookingForCreateDTO": {
        "required": [
          "deliveryAddress",
          "name",
          "paymentMethod",
          "surname",
          "username"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 50,
            "minLength": 3,
            "type": "string"
          },
          "surname": {
            "maxLength": 50,
            "minLength": 3,
            "type": "string"
          },
          "username": {
            "maxLength": 50,
            "minLength": 3,
            "type": "string"
          },
          "deliveryAddress": {
            "maxLength": 50,
            "minLength": 3,
            "type": "string",
            "format": "multiline"
          },
          "paymentMethod": {
            "$ref": "#/components/schemas/PaymentMethod"
          },
          "clientPhoneNumber": {
            "type": "string",
            "nullable": true
          },
          "bookingItems": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BookingItemDTO"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "BookingItemDTO": {
        "type": "object",
        "properties": {
          "bookingId": {
            "type": "integer",
            "format": "int32"
          },
          "comment": {
            "maxLength": 200,
            "minLength": 20,
            "type": "string",
            "nullable": true
          },
          "maintenanceId": {
            "type": "integer",
            "format": "int32"
          },
          "maintName": {
            "type": "string",
            "nullable": true
          },
          "price": {
            "type": "integer",
            "format": "int32"
          },
          "numberOfDays": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "CarForPurchasingDTO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "model": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string",
            "nullable": true
          },
          "color": {
            "type": "string",
            "nullable": true
          },
          "descripcion": {
            "type": "string",
            "nullable": true
          },
          "fuelType": {
            "type": "string",
            "nullable": true
          },
          "manufacture": {
            "type": "string",
            "nullable": true
          },
          "purchasingPrice": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "CarForRentalDTO": {
        "required": [
          "color",
          "description",
          "manufacturer",
          "quantityForRenting",
          "rentingPrice"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "color": {
            "maxLength": 50,
            "minLength": 0,
            "pattern": "^[A-Z]+[a-zA-Z''-'\\s]*$",
            "type": "string"
          },
          "description": {
            "maxLength": 1000,
            "minLength": 0,
            "pattern": "^[A-Z]+[a-zA-Z''-'\\s]*$",
            "type": "string"
          },
          "manufacturer": {
            "maxLength": 100,
            "minLength": 0,
            "pattern": "^[A-Z]+[a-zA-Z''-'\\s]*$",
            "type": "string"
          },
          "quantityForRenting": {
            "maximum": 100,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "rentingPrice": {
            "maximum": 1000000,
            "minimum": 1,
            "type": "integer",
            "format": "currency"
          },
          "model": {
            "type": "string",
            "nullable": true
          },
          "fuelType": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "MaintenanceDTO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "maxLength": 10,
            "minLength": 3,
            "type": "string",
            "nullable": true
          },
          "numberOfDays": {
            "maximum": 10,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "price": {
            "type": "integer",
            "format": "int32"
          },
          "maintenanceTypes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MaintenanceTypeDTO"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "MaintenanceTypeDTO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "type": {
            "maxLength": 10,
            "minLength": 3,
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "PaymentMethod": {
        "enum": [
          "GooglePay",
          "Visa",
          "Paypal",
          "TarjetaDeCredito",
          "Metálico"
        ],
        "type": "string"
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": { }
      },
      "PurchaseForCreateDTO": {
        "required": [
          "deliveryAddress",
          "name",
          "paymentMethod",
          "purchaseDate",
          "quantity",
          "surname"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "minLength": 1,
            "type": "string"
          },
          "surname": {
            "minLength": 1,
            "type": "string"
          },
          "deliveryAddress": {
            "minLength": 1,
            "type": "string",
            "format": "multiline"
          },
          "paymentMethod": {
            "$ref": "#/components/schemas/PaymentMethod"
          },
          "quantity": {
            "type": "integer",
            "format": "int32"
          },
          "purchaseItemDTO": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PurchaseItemDTO"
            },
            "nullable": true
          },
          "purchaseDate": {
            "type": "string",
            "format": "date"
          },
          "price": {
            "type": "integer",
            "format": "int32"
          },
          "username": {
            "type": "string",
            "nullable": true
          },
          "TotalPrice": {
            "type": "integer",
            "format": "int32",
            "readOnly": true
          }
        },
        "additionalProperties": false
      },
      "PurchaseForDetailsDTO": {
        "required": [
          "paymentMethod",
          "purchaseDate",
