@page "/rental/createrental"
@using AppForSEII2526.Web.API
@using AppForSEII2526.Web.Components.Shared
@using Microsoft.AspNetCore.Authorization
@inject AppForSEII2526APIClient apiclient
@inject ILogger<CreateRental> logger
@inject RentalStateContainer rentalContainer
@inject NavigationManager navigation

@attribute [Authorize]
<h3>CreateRental</h3>
<EditForm Model="rental" OnValidSubmit="OpenDialog">
    <div class="row">
        <DataAnnotationsValidator />
        <ValidationSummary class="row alert alert-danger" />
    </div>
    <div class="row alert alert-danger" role="alert" hidden="@hideErrors">
        <p id="ErrorsShown">Errors: @messageError</p>
    </div>
    <div class="row g-3">
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="rental.Name" class="form-control" id="Name" />
                <label for="Name">Name </label>
            </div>
        </div>
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="rental.Surname" class="form-control" id="Surname" />
                <label for="Name">Surname </label>
            </div>
        </div>
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="rental.DeliveryAddress" class="form-control" id="DeliveryAddress" />
                <label for="DeliveryAddress">Delivery Address</label>
            </div>
        </div>
    </div>
    <div class="row g-2">
        <p>number of cars @rental.RentalItems.Count</p>
        <div class="col-md">
            <div class="form-floating">
                @*a dropdown for selecting the payment method*@
                <InputSelect class="form-select" @bind-Value="@rental.PaymentMethod" id="PaymentMethod">
                    <option value="@PaymentMethod.TarjetaDeCredito" default> CreditCard</option>
                    <option value="@PaymentMethod.Paypal"> PayPal</option>
                    <option value="@PaymentMethod.Metálico"> Cash</option>
                    <option value="@PaymentMethod.GooglePay"> GooglePay</option>
                    <option value="@PaymentMethod.Visa"> Visa</option>
                </InputSelect>
                <label for="PaymentMethod">Payment Method</label>
            </div>
        </div>


        <div class="col-md">
            <div class="form-floating">
                @*this button will be used to ask the user if he want to proceed to rent the movies*@
                <button class="btn btn-primary" type="submit" id="Submit" disabled="@rentalButtonDisabled">
                    Rent cars
                </button>
            </div>
        </div>
    </div>
    <h4>Rental detail</h4>
    <p><b>Total days:</b> @NumberOfDays</p>
    <p>
        <b>Total price:</b> @TotalPrice €
        <button class="btn btn-outline-primary" type="submit" @onclick="ModifyRentalItems" id="ModifyRentals">
            Modify rental
        </button>
    </p>
    <div class="mh-100 table-responsive">
        <table class="table table-condensed table-hover" id="TableOfRentalItems">
            <thead>
                <tr>
                    <th>Model</th>
                    <th>Manufacturer</th>
                    <th>Price</th>
                    <th>Quantity</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in rental.RentalItems)
                {
                    <tr id="RentalId_@item.RentalId">
                        <td>@item.Car</td>
                        <td>@item.Manufacturer</td>
                        <td>@item.RentingPrice</td>
                        <td><InputNumber @bind-Value="item.Quantity" class="form-control" id="@($"Quantity_{item.CarId}")" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</EditForm>

@*a modal popup dialog for checking if user wants to proceed to rent*@
@if (DialogIsOpen)
{
    <Dialog Caption="Rented Cars"
            Message="Do you want to proceed to rent the selected cars?"
            OnClose="@OnDialogClose"
            Type=Dialog.Category.SaveNot>
    </Dialog>
}

@code {
    private string messageError = "";
    private bool rentalButtonDisabled { get { return (rental.RentalItems == null || rental.RentalItems.Count == 0); } }
    private bool hideErrors { get { return messageError.Length == 0; } }
    private bool DialogIsOpen;
    private int NumberOfDays
    {
        get
        {
            return (rental.EndDate - rental.StartDate).Days;
        }
    }
    private int TotalPrice
    {
        get
        {
            int price = rental.RentalItems.Sum(ri => ri.RentingPrice * NumberOfDays * ri.Quantity);
            return price;
        }
    }
    private void ModifyRentalItems()
    {
        navigation.NavigateTo("/rental/selectcarsforrental");
    }
    private RentalForCreateDTO rental => rentalContainer.Rental;
    private void OpenDialog()
    {
        DialogIsOpen = true;
    }

    private async Task OnDialogClose(bool isOk)
    {

        DialogIsOpen = false;
        if (isOk)
        {
            if (rental.RentalItems.Count > 0)
            {
                try
                {
                    var rented = await apiclient.CreateRentalAsync(rental);
                    rentalContainer.RentalProcessed();
                    navigation.NavigateTo($"/rental/detailrental/?rentalId={rented.Id}");
                }
                catch (ApiException<ValidationProblemDetails> apiexceptionvalidation)
                {

                    if (apiexceptionvalidation.Result.Errors.Values != null)
                    {
                        messageError = "";
                        foreach (var errors in apiexceptionvalidation.Result.Errors.Values)
                            //https://learn.microsoft.com/en-us/dotnet/api/system.string.join?view=net-7.0
                            messageError = string.Join("(*) ", messageError, string.Join(" (*) ", errors));
                    }
                }
                catch (ApiException apiexception)
                {
                    //we need to inform user that there was some other error while processing the request
                    messageError = "Error while processing your request, please try again later!";

                }

            }
        }
    }
    protected override async Task OnInitializedAsync()
    {
        rental.StartDate = DateTime.Today.AddDays(1);
        rental.EndDate = DateTime.Today.AddDays(8);
        rental.RentingDate = DateTime.Today;

        if (authenticationState is not null)
        {
            var authState = await authenticationState;
            var user = authState?.User;

            if (user is not null)
            {
                if (user.Identity is not null && user.Identity.IsAuthenticated)
                {
                    rental.Username = user.Identity.Name;
                }
            }
            rental.Name = rental.Name == null ? "" : rental.Name;
            rental.Surname = rental.Surname == null ? "" : rental.Surname;
            rental.DeliveryAddress = rental.DeliveryAddress == null ? "" : rental.DeliveryAddress;

        }
    }


    [CascadingParameter]
    private Task<AuthenticationState>? authenticationState { get; set; }
}
}
