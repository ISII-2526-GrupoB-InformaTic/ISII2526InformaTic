@page "/rental/selectcarsforrental"

@using Microsoft.AspNetCore.Authorization
@using AppForSEII2526.Web.API
@inject AppForSEII2526APIClient apiclient
@inject ILogger<SelectCarsForRental> logger
@inject RentalStateContainer rentalState
@inject NavigationManager navigation


<h3>Rentals</h3>
<div class="container-fluid">
    <div class="row alert alert-danger" role="alert" hidden="@hideErrors">
        <p id="ErrorsShown">Errors: @errors</p>
    </div>
    <div class="row">
        <div class="col-8">
            <div class="row">
                <div class="col">
                    <div class="input-group mb-3">
                        <span class="input-group-text" id="basic-addon1">Model</span>
                        <input type="text" id="inputModel" @bind=carModel class="form-control" placeholder="Model" aria-label="Model" aria-describedby="basic-addon1">
                    </div>
                </div>
                <div class="col">
                    <div class="input-group mb-3">
                        <span class="input-group-text" id="basic-addon1">Minimum Price</span>
                        <input type="text" id="inputminPrice" @bind=minimumPrice class="form-control" placeholder="Minimum Price" aria-label="Minimum Price" aria-describedby="basic-addon1">
                    </div>
                </div>
                <div class="col">
                    <div class="input-group mb-3">
                        <span class="input-group-text" id="basic-addon1">Maximum Price</span>
                        <input type="text" id="inputmaxPrice" @bind=maximumPrice class="form-control" placeholder="Maximum Price" aria-label="Maximum Price" aria-describedby="basic-addon1">
                    </div>
                </div>
                <div class="col">
                    <button type="button" class="btn btn-primary" @onclick=@SearchCars id="searchCars">Search Cars</button>
                </div>
            </div>
            <div class="row">
                @if (cars == null)
                {
                    <p>Loading cars....</p>
                }
                else
                {
                    <p>number of cars @cars.Count</p>
                    <div class="mh-100 table-responsive">
                        <table class="table table-condensed table-hover" id="TableOfCars">
                            <thead>
                                <tr>
                                    <th>Model</th>
                                    <th>Manufacturer</th>
                                    <th>Rental Price</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var car in cars)
                                {
                                    <tr id="carToRent_@car.Model">
                                        <td>@car.Model</td>
                                        <td>@car.Manufacturer</td>
                                        <td>@car.RentingPrice</td>
                                        <td>
                                            <button class="btn btn-outline-secondary" id="carToRent_@car.Model" @onclick="@(() => AddCar(car))">Add</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
            <div class="col-2" hidden="@hideRentingCart">
                <div class="row">
                    <h3>Shopping Cart</h3>
                </div>
                @foreach (RentalItemDTO item in rental.RentalItems)
                {
                    <div class="row">
                        <button type="button" class="btn btn-light" id="removeCar_@item.Car" @onclick="@(() => RemoveRentalItem(item))">x @item.Car - @item.RentingPrice€</button>
                    </div>
                }
                <div class="row">
                    <button type="button" class="btn btn-primary" id="purchaseCarButton" @onclick=@RentCars>Rent cars</button>
                </div>
        </div>

    </div>

</div>
@code {
    private ICollection<CarForRentalDTO> cars;
    private bool hideRentingCart { get { return rental.RentalItems.Count == 0; } }
    private bool hideErrors { get { return errors.Length == 0; } }
    private string errors = "";
    private string carModel { get; set; }
    private int minimumPrice { get; set; }
    private int maximumPrice { get; set; }

    private RentalForCreateDTO rental => rentalState.Rental;

    private bool hiddenRentingCart = true;

    private void AddCar(CarForRentalDTO car)
    {
        rentalState.AddCarToRental(car);
    }

    private void RemoveRentalItem(RentalItemDTO item)
    {
        rentalState.RemoveRentalItemToRent(item);
        if (rental.RentalItems.Count == 0) hiddenRentingCart = true;
    }

    public async void SearchCars()
    {
        try
        {
            cars = await apiclient.GetCarsForRentingAsync(carModel,minimumPrice,maximumPrice);

        }
        catch (Exception ex)
        {
            logger.LogError($"{DateTime.Now} Error: {ex}");
            errors = "Error while connecting to the system";
        }
        StateHasChanged();
    }

    protected override Task OnInitializedAsync()
    {


        SearchCars();

        return base.OnInitializedAsync();
    }

    private void RentCars()
    {
        navigation.NavigateTo("/rentals/createrental");
    }
}
