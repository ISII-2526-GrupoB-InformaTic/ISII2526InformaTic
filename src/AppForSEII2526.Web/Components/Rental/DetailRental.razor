@page "/rental/detailrental"
@using AppForSEII2526.Web.API
@using Microsoft.AspNetCore.Authorization
@inject AppForSEII2526APIClient apiclient
@attribute [Authorize]
<h3>DetailRental</h3>


@if (rental == null)
{
    <p>@error</p>
}
else
{
    <table class="table table-borderless table-sm">
        <tr>
            <th>Name and Surname</th>
            <td id="NameSurname">@rental.Name @rental.Surname</td>
        </tr>
        <tr>
            <th>Delivery Address</th>
            <td id="DeliveryAddress">@rental.DeliveryAddress</td>
        </tr>
        <tr>
            <th>Payment Method</th>
            <td id="PaymentMethod">@rental.PaymentMethod</td>
        </tr>
        <tr>
            <th>Rental Date</th>
            <td id="RentingDate">@rental.RentingDate.ToString("dd/MM/yyyy hh:mm:ss")</td>
        </tr>
        <tr>
            <th>Rental Start Date</th>
            <td id="StartDate">@rental.StartDate.ToString("dd/MM/yyyy hh:mm:ss")</td>
        </tr>
        <tr>
            <th>Rental End Date</th>
            <td id="EndDays">@rental.EndDate.ToString("dd/MM/yyyy hh:mm:ss")</td>
        </tr>
    </table>

    <h4>Rented Cars</h4>

    <table class="table" id="RentedCars">
        <thead>
            <tr>
                <th scope="col">Model</th>
                <th scope="col">Manufacturer</th>
                <th scope="col">Price</th>
                <th scope="col">Quantity</th>
            </tr>
        </thead>
        <tbody>
            @foreach (RentalItemDTO item in rental.RentalItems)
            {
                <tr id="RentalItem_@item.Car">
                    <td>@item.Car</td>
                    <td>@item.Manufacturer</td>
                    <td>@item.RentingPrice</td>
                    <td>@item.Quantity</td>
                </tr>
            }
        </tbody>
        <tfoot>
            @*colspan is used to state that TWO columns are collapsed*@
        <th scope="row" colspan="2" class="text-end">Total Price</th>
        <td id="TotalPrice">@TotalPrice €</td>
        </tfoot>

    </table>

}

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public int rentalId { get; set; }
    private RentalDetailDTO rental;
    private string error = "";

    private int NumberOfDays
    {
        get
        {
            return (rental.EndDate - rental.StartDate).Days;
        }
    }
    private int TotalPrice
    {
        get
        {
            int price = rental.RentalItems.Sum(ri => ri.RentingPrice * NumberOfDays * ri.Quantity);
            return price;
        }
    }
    [CascadingParameter]
    private Task<AuthenticationState>? authenticationState { get; set; }
    protected override async Task OnInitializedAsync()
    {

        //we check the user is logged in
        string userName = "";
        if (authenticationState is not null)
        {
            var authState = await authenticationState;
            var user = authState?.User;

            //we retrieve the id of the user logged in
            if (user is not null)
            {
                if (user.Identity is not null && user.Identity.IsAuthenticated && user.IsInRole("User"))
                {
                    userName = user.Identity.Name;
                }
            }
        }

        try
        {
            rental = await apiclient.GetRentalAsync(rentalId);
        }
        catch (ApiException exception)
        {
            rental = null;
        }
        if ((rental == null) || (rental.Name != userName))
        {
            error = $"Error! You are not authorized to see this rental or there is not a rental with id={rentalId}";
        }


    }

}
