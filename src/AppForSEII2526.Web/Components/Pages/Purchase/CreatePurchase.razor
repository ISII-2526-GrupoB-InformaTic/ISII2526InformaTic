@page "/purchase/createpurchase"
@using AppForSEII2526.Web.API
@using AppForSEII2526.Web.Components.Shared
@using Microsoft.AspNetCore.Authorization
@inject AppForSEII2526APIClient apiclient
@inject ILogger<CreatePurchase> logger
@inject PurchaseStateContainer purchaseContainer
@inject NavigationManager navigation

@attribute [Authorize]
<h3>CreatePurchase</h3>
<EditForm Model="purchase" OnValidSubmit="OpenDialog">
    <div class="row">
        <DataAnnotationsValidator />
        <ValidationSummary class="row alert alert-danger" />
    </div>
    <div class="row alert alert-danger" role="alert" hidden="@hideErrors">
        <p id="ErrorsShown">Errors: @messageError</p>
    </div>
    <div class="row g-3">
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="purchase.Name" class="form-control" id="Name" />
                <label for="Name">Name </label>
            </div>
        </div>
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="purchase.Surname" class="form-control" id="Surname" />
                <label for="Name">Surname </label>
            </div>
        </div>
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="purchase.DeliveryAddress" class="form-control" id="DeliveryAddress" />
                <label for="DeliveryAddress">Delivery Address</label>
            </div>
        </div>
    </div>
    <div class="row g-2">
        <p>number of cars @purchase.PurchaseItemDTO.Count</p>
        <div class="col-md">
            <div class="form-floating">
                @*a dropdown for selecting the payment method*@
                <InputSelect class="form-select" @bind-Value="@purchase.PaymentMethod" id="PaymentMethod">
                    <option value="@PaymentMethod.TarjetaDeCredito" default> CreditCard</option>
                    <option value="@PaymentMethod.Paypal"> PayPal</option>
                    <option value="@PaymentMethod.Metálico"> Cash</option>
                    <option value="@PaymentMethod.GooglePay"> GooglePay</option>
                    <option value="@PaymentMethod.Visa"> Visa</option>
                </InputSelect>
                <label for="PaymentMethod">Payment Method</label>
            </div>
        </div>


        <div class="col-md">
            <div class="form-floating">
                @*this button will be used to ask the user if he want to proceed to rent the movies*@
                <button class="btn btn-primary" type="submit" id="Submit" disabled="@purchaseButtonDisabled">
                    Purchase cars
                </button>
            </div>
        </div>
    </div>
    <h4>Purchase detail</h4>
    <p>
        <b>Total price:</b> @TotalPrice €
        <button class="btn btn-outline-primary" type="submit" @onclick="ModifyPurchaseItems" id="ModifyPurchases">
            Modify purchases
        </button>
    </p>
    <div class="mh-100 table-responsive">
        <table class="table table-condensed table-hover" id="TableOfPurchaseItems">
            <thead>
                <tr>
                    <th>Model</th>
                    <th>Color</th>
                    <th>Description</th>
                    <th>Price</th>
                    <th>Quantity</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in purchase.PurchaseItemDTO)
                {
                    <tr id="PurchaseId_@item.PurchaseId">
                        <td>@item.Car</td>
                        <td>@item.Color</td>
                        <td>@item.Descripcion</td>
                        <td>@item.Price</td>
                        <td><InputNumber @bind-Value="item.Quantity" class="form-control" id="@($"Quantity_{item.CarId}")" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</EditForm>

@*a modal popup dialog for checking if user wants to proceed to rent*@
@if (DialogIsOpen)
{
    <Dialog Caption="Purchase Cars"
            Message="Do you want to proceed to purchase the selected cars?"
            OnClose="@OnDialogClose"
            Type=Dialog.Category.SaveNot>
    </Dialog>
}

@code {
    private string messageError = "";
    private bool purchaseButtonDisabled { get { return (purchase.PurchaseItemDTO == null || purchase.PurchaseItemDTO.Count == 0); } }
    private bool hideErrors { get { return messageError.Length == 0; } }
    private bool DialogIsOpen;
    
    private int TotalPrice
    {
        get
        {
            int price = purchase.PurchaseItemDTO.Sum(pi => pi.Price * pi.Quantity);
            return price;
        }
    }
    private void ModifyPurchaseItems()
    {
        navigation.NavigateTo("/purchase/SelectCarForPurchasing");
    }
    private PurchaseForCreateDTO purchase => purchaseContainer.Purchase;
    private void OpenDialog()
    {
        DialogIsOpen = true;
    }

    private async Task OnDialogClose(bool isOk)
    {

        DialogIsOpen = false;
        if (isOk)
        {
            if (purchase.PurchaseItemDTO.Count > 0)
            {
                try
                {
                    var purchased = await apiclient.CreatePurchaseAsync(purchase);
                    purchaseContainer.PurchaseProcessed();
                    navigation.NavigateTo($"/purchase/detailpurchase/?purchaseId={purchased.Id}");
                }
                catch (ApiException<ValidationProblemDetails> apiexceptionvalidation)
                {

                    if (apiexceptionvalidation.Result.Errors.Values != null)
                    {
                        messageError = "";
                        foreach (var errors in apiexceptionvalidation.Result.Errors.Values)
                            //https://learn.microsoft.com/en-us/dotnet/api/system.string.join?view=net-7.0
                            messageError = string.Join("(*) ", messageError, string.Join(" (*) ", errors));
                    }
                }
                catch (ApiException apiexception)
                {
                    //we need to inform user that there was some other error while processing the request
                    messageError = "Error while processing your request, please try again later!";

                }

            }
        }
    }
    protected override async Task OnInitializedAsync()
    {

        purchase.PurchaseDate = DateTime.Today;

        if (authenticationState is not null)
        {
            var authState = await authenticationState;
            var user = authState?.User;

            if (user is not null)
            {
                if (user.Identity is not null && user.Identity.IsAuthenticated)
                {
                    purchase.Username = user.Identity.Name;
                }
            }
            purchase.Name = purchase.Name == null ? "" : purchase.Name;
            purchase.Surname = purchase.Surname == null ? "" : purchase.Surname;
            purchase.DeliveryAddress = purchase.DeliveryAddress == null ? "" : purchase.DeliveryAddress;

        }
    }


    [CascadingParameter]
    private Task<AuthenticationState>? authenticationState { get; set; }
}
}
