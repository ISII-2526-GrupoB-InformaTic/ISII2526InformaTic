@page "/booking/createbooking"
@using AppForSEII2526.Web.API
@using AppForSEII2526.Web.Components.Shared
@using Microsoft.AspNetCore.Authorization
@inject AppForSEII2526APIClient apiclient
@inject ILogger<CreateBooking> logger
@inject BookingStateContainer bookingState
@inject NavigationManager navigation

@attribute [Authorize]
<h3>CreateBooking</h3>
<EditForm Model="booking" OnValidSubmit="OpenDialog">
    <div class="row">
        <DataAnnotationsValidator />
        <ValidationSummary class="row alert alert-danger" />
    </div>
    <div class="row alert alert-danger" role="alert" hidden="@hideErrors">
        <p id="ErrorsShown">Errors: @messageError</p>
    </div>
    <div class="row g-3">
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="booking.Name" class="form-control" id="Name" />
                <label for="Name">Name </label>
            </div>
        </div>
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="booking.Surname" class="form-control" id="Surname" />
                <label for="Name">Surname </label>
            </div>
        </div>
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="booking.DeliveryAddress" class="form-control" id="DeliveryAddress" />
                <label for="DeliveryAddress">Delivery Address</label>
            </div>
        </div>
    </div>
        <div class="row g-2">
        <div class="col-md">
            <div class="form-floating">
                @*a dropdown for selecting the payment method*@
                <InputSelect class="form-select" @bind-Value="@booking.PaymentMethod" id="PaymentMethod">
                    <option value="@PaymentMethod.TarjetaDeCredito" default> CreditCard</option>
                    <option value="@PaymentMethod.Paypal"> PayPal</option>
                    <option value="@PaymentMethod.Metálico"> Cash</option>
                    <option value="@PaymentMethod.GooglePay"> GooglePay</option>
                    <option value="@PaymentMethod.Visa"> Visa</option>
                </InputSelect>
                <label for="PaymentMethod">Payment Method</label>
            </div>
        </div>
        <div class="col-md">
            <div class="form-floating mb-3">
                <InputText @bind-Value="booking.ClientPhoneNumber" class="form-control" id="ClientPhoneNumber" />
                <label for="ClientPhoneNumber">Client PhoneNumber</label>
            </div>
        </div>

        <div class="col-md">
            <div class="form-floating">
                @*this button will be used to ask the user if he want to proceed to rent the movies*@
                <button class="btn btn-primary" type="submit" id="Submit" disabled="@bookingButtonDisabled">
                    Book your maintenances
                </button>
            </div>
        </div>
    </div>
    <h4>Booking detail</h4>
    <p><b>Total days:</b> @TotalDays</p>
    <p>
        <b>Total price:</b> @TotalCost €
        <button class="btn btn-outline-primary" type="submit" @onclick="ModifyBookingItems" id="ModifyMaintenances">
            Modify maintenances
        </button>
    </p>
    <div class="mh-100 table-responsive">
        <table class="table table-condensed table-hover" id="TableOfBookingItems">
            <thead>
                <tr>
                    <th>MaintName</th>
                    <th>Price</th>
                    <th>NumberOfDays</th>
                    <th>Comment</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in booking.BookingItems)
                {
                    <tr id="MovieData_@item.MaintName">
                        <td>@item.MaintName</td>
                        <td>@item.Price</td>
                        <td>@item.NumberOfDays</td>
                        <td><InputText @bind-Value="item.Comment" class="form-control" id="@($"Comment_{item.MaintenanceId}")" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</EditForm>

@*a modal popup dialog for checking if user wants to proceed to rent*@
@if (DialogIsOpen)
{
    <Dialog Caption="Booked Maintenances"
            Message="Do you want to proceed to book the selected maintenances?"
            OnClose="@OnDialogClose"
            Type=Dialog.Category.SaveNot>
    </Dialog>
}

@code {
    private string messageError = "";
    private bool bookingButtonDisabled { get { return (booking.BookingItems == null || booking.BookingItems.Count == 0); } }
    private bool hideErrors { get { return messageError.Length == 0; } }
    private bool DialogIsOpen;
    private int TotalDays
    {
        get
        {
            int days = booking.BookingItems.Sum(ri => ri.NumberOfDays);
            return days;
        }
    }
    private int TotalCost
    {
        get
        {
            int price = booking.BookingItems.Sum(ri => ri.Price);
            return price;
        }
    }
    private void ModifyBookingItems()
    {
        navigation.NavigateTo("/booking/selectmaintenancesforbooking");
    }
    private BookingForCreateDTO booking => bookingState.Booking;
    private void OpenDialog()
    {
        DialogIsOpen = true;
    }

    private async Task OnDialogClose(bool isOk)
    {

        DialogIsOpen = false;
        if (isOk)
        {
            if (booking.BookingItems.Count > 0)
            {
                try
                {
                    var booked = await apiclient.CreateBookingAsync(booking);
                    bookingState.BookingProcessed();
                    navigation.NavigateTo($"/booking/detailbooking/?BookingId={booked.Id}");
                }
                catch (ApiException<ValidationProblemDetails> apiexceptionvalidation)
                {

                    if (apiexceptionvalidation.Result.Errors.Values != null)
                    {
                        messageError = "";
                        foreach (var errors in apiexceptionvalidation.Result.Errors.Values)
                            //https://learn.microsoft.com/en-us/dotnet/api/system.string.join?view=net-7.0
                            messageError = string.Join("(*) ", messageError, string.Join(" (*) ", errors));
                    }
                }
                catch (ApiException apiexception)
                {
                    //we need to inform user that there was some other error while processing the request
                    messageError = "Error while processing your request, please try again later!";

                }

            }
        }
    }
    protected override async Task OnInitializedAsync()
    {

        if (authenticationState is not null)
        {
            var authState = await authenticationState;
            var user = authState?.User;

            if (user is not null)
            {
                if (user.Identity is not null && user.Identity.IsAuthenticated)
                {
                    booking.Username = user.Identity.Name;
                }
            }
            booking.Name = booking.Name == null ? "" : booking.Name;
            booking.Surname = booking.Surname == null ? "" : booking.Surname;
            booking.DeliveryAddress = booking.DeliveryAddress == null ? "" : booking.DeliveryAddress;

        }
    }


    [CascadingParameter]
    private Task<AuthenticationState>? authenticationState { get; set; }
}
}
